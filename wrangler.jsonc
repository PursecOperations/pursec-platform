{
  // Web pública de PURSEC (pursec.club). Solo se publica la carpeta public/;
  // el resto del repo (scripts, workers) nunca se sirve.
  "name": "pursec-platform",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  "keep_vars": true,
  // Worker Previews: cada rama tiene su URL de prueba antes de llegar a producción
  "previews": {}
}
