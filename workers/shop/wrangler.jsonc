{
  // Worker de la tienda (Agente 07 · Orders): pagos con Stripe Checkout y pedidos a Printful.
  // Se despliega desde GitHub con Workers Builds, carpeta raíz: workers/shop
  "name": "pursec-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Conserva los secretos definidos en el panel de Cloudflare:
  // SUPABASE_SERVICE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PRINTFUL_TOKEN, PRINTFUL_WEBHOOK_TOKEN
  "keep_vars": true,
  "previews": {},
  "vars": {
    "SUPABASE_URL": "https://uymgrzlbpaqorbwajhfh.supabase.co",
    "SITE_URL": "https://pursec.club",
    "ALLOWED_ORIGINS": "https://pursec.club,https://www.pursec.club",
    // Precio del envío que paga el cliente, en euros. [PENDIENTE] fijarlo con las tarifas reales de Printful.
    "SHIPPING_EUR": "",
    "SHIPPING_LABEL": "Standard shipping (EU)",
    // "true" = Printful fabrica en cuanto llega el pedido. Mientras sea "false", los pedidos entran como borrador.
    "PRINTFUL_CONFIRM": "false"
  }
}
