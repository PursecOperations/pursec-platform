{
  // Worker de la tienda: pagos con Stripe Checkout, pedidos y stock en Supabase. El envío lo hace Oriol.
  // Se despliega desde GitHub con Workers Builds, carpeta raíz: workers/shop
  "name": "pursec-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Conserva los secretos definidos en el panel de Cloudflare:
  // SUPABASE_SERVICE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
  "keep_vars": true,
  "previews": {},
  "vars": {
    "SUPABASE_URL": "https://uymgrzlbpaqorbwajhfh.supabase.co",
    "SITE_URL": "https://pursec.club",
    "ALLOWED_ORIGINS": "https://pursec.club,https://www.pursec.club",
    // Envío (decidido por Oriol el 24 oct 2026): 4,95 € en toda la UE; gratis si las prendas superan 70 €.
    "SHIPPING_EUR": "4.95",
    "FREE_SHIPPING_FROM": "70",
    "SHIPPING_LABEL": "Standard shipping (EU)",
    "FREE_SHIPPING_LABEL": "Free shipping (EU)"
  }
}
